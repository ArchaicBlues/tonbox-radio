[Unit]
Description=Tonbox Service (Node.js Bluetooth Speaker)
After=network-online.target pipewire.service wireplumber.service bt-a2dp-monitor.service
Wants=network-online.target pipewire.service wireplumber.service bt-a2dp-monitor.service

[Service]
Type=simple
WorkingDirectory=/home/pi/Tonbox

# Statt eines hartcodierten "/home/pi/.nvm/versions/node/vX.Y.Z/bin/node" - nvm installiert
# je nach Zeitpunkt/Geraet eine andere exakte Patch-Version, ein fest eingetragener Pfad
# brach deshalb auf jedem Geraet mit abweichender Version (EXEC-Fehler). "bash -lc" (Login-
# Shell) loest das NICHT: Debian/Raspberry-Pi-OS' Standard-~/.bashrc bricht fuer
# nicht-interaktive Shells (genau das, was systemd startet) ganz am Anfang ab, bevor die
# nvm-Sourcing-Zeilen weiter unten je erreicht werden. nvms eigenes Hilfsskript "nvm-exec"
# waere dafuer gebaut, ist aber je nach Installationsart/-zeitpunkt nicht auf jedem Geraet
# vorhanden - deshalb hier direkt nachgebildet: nvm.sh (das eigentliche Kernskript, das
# jede nvm-Installation besitzt) wird selbst eingebunden, danach loest "nvm use" ueber die
# .nvmrc-Datei im WorkingDirectory (pinnt nur Major-Version "21", nicht den exakten Patch)
# die passende installierte Version auf.
ExecStart=/bin/bash -c 'export NVM_DIR="/home/pi/.nvm"; . "$NVM_DIR/nvm.sh" --no-use; nvm use >/dev/null; exec node /home/pi/Tonbox/server.js'

Restart=always
RestartSec=5

Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000

StandardOutput=journal
StandardError=journal
SyslogIdentifier=Tonbox

[Install]
WantedBy=default.target
