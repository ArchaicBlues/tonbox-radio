<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head'); %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="/button.css">
     
    <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon/android-chrome-192x192.png">

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <style>
    .btn-disabled {
        opacity: 0.4;
        filter: grayscale(60%);
        cursor: not-allowed;
    }
    .audio-system-card {
        background: rgba(20, 20, 40, 0.9);
        border: 1px solid var(--glass-border);
        border-radius: 12px;
        padding: 15px 20px;
        max-width: 400px;
        font-family: 'Inter', sans-serif;
        color: white;
    }

    .audio-options {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 10px;
    }

    .audio-option {
        display: flex;
        align-items: center;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 8px;
        padding: 8px 12px;
        cursor: pointer;
        transition: all 0.2s ease;
        user-select: none;
    }

    .audio-option:hover {
        background: rgba(255, 255, 255, 0.15);
    }

    .audio-option input[type="radio"] {
        display: none; /* hide the default radio button */
    }

    .audio-option span {
        position: relative;
        padding-left: 28px;
    }

    .audio-option span::before {
        content: "";
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 18px;
        height: 18px;
        border: 2px solid #0ff;
        border-radius: 50%;
        background: transparent;
        transition: all 0.2s;
    }

    .audio-option input[type="radio"]:checked + span::before {
        background: #0ff;
        box-shadow: 0 0 5px #0ff;
    }


    .wifi-card {
        background: rgba(20, 20, 40, 0.95);
        border: 1px solid var(--glass-border);
        border-radius: 12px;
        padding: 20px 25px;
        max-width: 400px;
        margin: 0 auto 20px auto;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0,0,0,0.4);
        font-family: 'Inter', sans-serif;
        color: white;
    }

    .wifi-card h4 {
        margin-bottom: 15px;
        color: var(--accent-color);
    }

    .wifi-inputs {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 20px;
        text-align: left;
    }

    .wifi-inputs label {
        font-size: 0.9rem;
        margin-bottom: 4px;
        display: block;
        color: #ccc;
    }

    .wifi-input {
        padding: 10px 12px;
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,0.2);
        background: rgba(255,255,255,0.05);
        color: white;
        font-size: 1rem;
        transition: all 0.2s;
        width: 100%;
    }

    .wifi-input:focus {
        outline: none;
        border-color: var(--accent-color);
        box-shadow: 0 0 8px var(--accent-color);
        background: rgba(255,255,255,0.1);
    }

    .wifi-actions {
        display: flex;
        justify-content: center;
    }

    .wifi-btn {
        background: var(--accent-color);
        color: black;
        border: none;
        padding: 10px 25px;
        border-radius: 25px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .wifi-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0,255,255,0.4);
    }

h2 { margin-top:0; }
label { display:block; margin-top:20px; }
input { width:100%; padding:8px; margin-top:5px; border-radius:4px; border:none; }
button { margin-top:25px; padding:10px 20px; border:none; border-radius:4px; cursor:pointer; }

.tv-results {
    margin-top: 12px;
    display: grid;
    gap: 10px;
}

.tv-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 10px;
    padding: 10px 12px;
}

.tv-title {
    font-weight: 600;
    color: #fff;
    font-size: 0.95rem;
}

.tv-meta {
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.8rem;
    margin-top: 4px;
}

.tv-cap-list {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.tv-cap {
    border-radius: 999px;
    padding: 3px 8px;
    font-size: 0.72rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.06);
}

.tv-cap-ok {
    border-color: rgba(78, 198, 116, 0.65);
    background: rgba(78, 198, 116, 0.18);
    color: #dbffe7;
}

.tv-cap-off {
    opacity: 0.72;
}

.tv-empty {
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.85rem;
}

</style>
</head>
<body>
    <%- include('../partials/header'); %>
    <script>
        let audioOut = JSON.stringify("<%- settings.mediaOut %>");
        console.log("audioOut="+audioOut);
    </script>
    <main class="container">
        <form action='../system', method='POST', content-type="text/javascript">
        <button class="btn-modern" type="submit" name="Back" value="Back"><i class="bi bi-arrow-left"></i> Back / Submit</button>
        <br><br>
        <% if (typeof notice !== 'undefined' && notice) { %>
            <div class="glass-panel p-3 mb-4" style="text-align:center; background:#5a1a1a; border:1px solid #ff4d4d;">
                <b>⚠ <%- notice %></b>
            </div>
        <% } %>
        <hr style="border-color:rgb(236, 6, 6)">
        <div class="audio-system-card">
            <b>Set Audio System:</b>
            <div class="audio-options">
                <!-- HTTP Web Option -->
                <label class="audio-option">
                    <input type="radio"
                        name="mediaSet"
                        value="HTTP live streaming"
                        <%= String(settings.mediaOut).includes("HTTP") ? "checked" : "" %>>
                    <span>HTTP Web</span>
                </label>

                <!-- Line-Out Options DAC / RPI-->
                <% for (var i = 0; i < audio.length; i++) { %>
                    <label class="audio-option">
                        <input type="radio" 
                            name="mediaSet"
                            value="<%- i %>" 
                            <%= i === Number(settings.mediaOut) ? "checked" : "" %>>
                        <span>Line-Out <%- audio[i] %></span>
                    </label>
                <% } %>
            </div>
        </div>

        <hr style="border-color:rgb(236, 6, 6)">
            <button class="btn-primary" type="submit" id="theme-toggle" name='sys' value="DESIGN" style="font-size:1.0rem">Change View</button>&nbsp;&nbsp;
            <br><br>
            <button class="btn-primary" type="submit" name='sys' value="UPDATE_TONBOX" style="font-size:1.0rem" onclick="document.getElementById('procStatusMsg').innerText='Please wait... Update Tonbox';">Update Tonbox</button>
            <div class="tv-empty" style="margin-top:6px;">MAC: <%- mac %> &nbsp; Secret: <%- settings.updateSecret %></div>
            <% if (updateCheck && updateCheck.message && !updateCheck.allowed) { %>
                <div class="glass-panel p-3 mb-4" style="text-align:center; margin-top:10px;">
                    <div class="tv-empty"><%- updateCheck.message %></div>
                    <% if (updateCheck.reason !== 'limit_reached') { %>
                        <div style="margin-top:10px; font-size:0.9rem;">
                            <label style="cursor:pointer; display:block;">
                                <input type="checkbox" id="agbAccept" onchange="updateBuyButtonState()">
                                Ich akzeptiere die <a href="/agb" target="_blank" rel="noopener">AGB &amp; Hinweise zur Zahlungsabwicklung</a>
                                und stimme ausdrücklich zu, dass mit der Ausführung des Vertrags (Freischaltung
                                des Updates) vor Ablauf der Widerrufsfrist begonnen wird. Mir ist bekannt, dass
                                ich dadurch mein <a href="/agb#widerruf" target="_blank" rel="noopener">Widerrufsrecht</a> verliere.
                            </label>
                        </div>
                        <script>
                        //buyUpdateBtn ist bewusst ein <button type="button"> statt <a>/<button type="submit">:
                        //dieser Block liegt innerhalb des aeusseren <form method="POST" action="../system">
                        //weiter oben auf dieser Seite - ein zweites, verschachteltes <form> waere ungueltiges
                        //HTML. Die Zustimmungs-Flags werden daher per JS als Query-Parameter an /buyUpdate
                        //durchgereicht, wo server.js sie NOCHMAL prueft (reines Client-JS liesse sich per
                        //Entwicklerkonsole trivial umgehen) und mit Zeitstempel protokolliert - sonst gaebe
                        //es ueberhaupt keinen Nachweis, dass diese Zustimmung tatsaechlich erteilt wurde.
                        function updateBuyButtonState(){
                            var ok = document.getElementById('agbAccept').checked;
                            var btn = document.getElementById('buyUpdateBtn');
                            btn.classList.toggle('btn-disabled', !ok);
                            btn.dataset.enabled = ok;
                        }
                        function goToBuyUpdate(){
                            if (document.getElementById('buyUpdateBtn').dataset.enabled !== 'true') {
                                alert('Bitte zuerst den Haken oben setzen.');
                                return;
                            }
                            //Serverseitiger Roundtrip (/buyUpdate: Zustimmungs-Pruefung/Protokollierung,
                            //dann Erstellung der Stripe-Checkout-Session) bleibt bestehen - der Browser
                            //wuerde sonst bis zur Antwort einfach die aktuelle Seite unveraendert zeigen.
                            //Overlay ueberbrueckt das, damit der Klick wie ein nahtloser Uebergang zu
                            //Stripe wirkt statt wie ein kurzes Haengenbleiben.
                            document.getElementById('buyRedirectOverlay').style.display = 'flex';
                            window.location.href = '/buyUpdate?agbAccept=1&withdrawalWaiver=1';
                        }
                        </script>
                        <button type="button" class="btn-primary btn-disabled" id="buyUpdateBtn" data-enabled="false"
                            style="font-size:1.0rem; margin-top:8px;"
                            onclick="goToBuyUpdate()">
                            Jetzt bezahlen (Stripe) - <%- updatePrice %>&euro;<%- stripeSandbox ? ' [Test]' : '' %>
                        </button>
                        <div id="buyRedirectOverlay" style="display:none; position:fixed; inset:0; background:#000;
                            color:#00d2ff; z-index:9999; flex-direction:column; justify-content:center;
                            align-items:center; font-size:1.3rem; font-family:sans-serif;">
                            <div style="border:6px solid #222; border-top:6px solid #00d2ff; border-radius:50%;
                                width:50px; height:50px; margin-bottom:24px; animation:spin 1s linear infinite;"></div>
                            <div>Weiterleitung zu Stripe …</div>
                        </div>
                        <style>@keyframes spin { 100% { transform: rotate(360deg); } }</style>
                        <div class="tv-empty" style="margin-top:10px;">
                            Oder: Die MAC-Adresse dieser Tonbox ist nicht registriert, aber bereits mit einer
                            anderen Tonbox bezahlt? Email und Secret dieser bezahlten Tonbox eingeben und
                            oben erneut auf "Update Tonbox" klicken:
                        </div>
                        <input type="text" name="claimEmail" placeholder="Email" style="margin:4px;">
                        <input type="text" name="claimSecret" placeholder="Secret der bezahlten Tonbox" style="margin:4px; width:260px;">
                    <% } %>
                </div>
            <% } %>
            <br>
            <button class="btn-primary" type="submit" name='sys' value="CHECKTV" style="font-size:1.0rem">Check TV</button>
            <div class="tv-results">
                <%
                    const tvData = Array.isArray(resultTV) ? resultTV : [];
                    const capOrder = [
                        'dlnaRenderer', 'dlnaServer', 'avTransport', 'setAVTransportURI', 'setNextAVTransportURI',
                        'play', 'stop', 'pause', 'seek', 'next', 'previous', 'webUriPlayable',
                        'dial', 'samsungRemoteControl', 'samsungMainTVAgent', 'chromecast', 'airplay'
                    ];
                %>
                <% if (tvData.length === 0) { %>
                    <div class="tv-empty">No TV data yet. Click "Check TV".</div>
                    <div class="tv-empty">Browser-Spiegelung "Media Show" an TV nicht möglich</div>
                <% } else { %>
                    <div class="tv-empty">Smart View auf TV möglich</div>
                    <% for (let i = 0; i < tvData.length; i++) { %>
                        <% const tv = tvData[i] || {}; %>
                        <% const caps = tv.capabilities && typeof tv.capabilities === 'object' ? tv.capabilities : {}; %>
                        <% const avTransport = tv.protocols && tv.protocols.avTransport && typeof tv.protocols.avTransport === 'object' ? tv.protocols.avTransport : {}; %>
                        <% const avTransportActions = Array.isArray(avTransport.actions) ? avTransport.actions : []; %>
                        <% const avActionSet = new Set(avTransportActions); %>
                        <% const normalizedCaps = Object.assign({}, caps, {
                            avTransport: avTransportActions.length > 0,
                            setAVTransportURI: avActionSet.has('SetAVTransportURI'),
                            setNextAVTransportURI: avActionSet.has('SetNextAVTransportURI'),
                            play: avActionSet.has('Play'),
                            stop: avActionSet.has('Stop'),
                            pause: avActionSet.has('Pause'),
                            seek: avActionSet.has('Seek'),
                            next: avActionSet.has('Next'),
                            previous: avActionSet.has('Previous')
                        }); %>
                        <% const avTransportCapOrder = [
                            'avTransport', 'setAVTransportURI', 'setNextAVTransportURI',
                            'play', 'stop', 'pause', 'seek', 'next', 'previous'
                        ]; %>
                        <div class="tv-card">
                            <div class="tv-title"><%- tv.name || 'Unknown device' %></div>
                            <div class="tv-meta">IP: <%- tv.ip || '-' %> | <%- tv.manufacturer || '-' %> | <%- tv.model || '-' %></div>
                            <div class="tv-meta">Recommended: <%- tv.recommended || '-' %></div>
                            <div class="tv-meta">AVTransport: <%- avTransport.serviceType || '-' %></div>
                            <div class="tv-meta">Control URL: <%- avTransport.controlURL || '-' %></div>
                            <div class="tv-meta">Event Sub URL: <%- avTransport.eventSubURL || '-' %></div>
                            <div class="tv-meta">SCPD URL: <%- avTransport.SCPDURL || '-' %></div>
                            <div class="tv-cap-list">
                                <% if (avTransportActions.length === 0) { %>
                                    <span class="tv-cap tv-cap-off">actions: none</span>
                                <% } else { %>
                                    <% for (let a = 0; a < avTransportActions.length; a++) { %>
                                        <span class="tv-cap tv-cap-ok"><%- avTransportActions[a] %></span>
                                    <% } %>
                                <% } %>
                            </div>
                            <div class="tv-cap-list">
                                <% for (let c = 0; c < avTransportCapOrder.length; c++) { %>
                                    <% const key = avTransportCapOrder[c]; %>
                                    <% const enabled = !!normalizedCaps[key]; %>
                                    <span class="tv-cap <%- enabled ? 'tv-cap-ok' : 'tv-cap-off' %>"><%- key %>: <%- enabled ? 'true' : 'false' %></span>
                                <% } %>
                            </div>
                            <div class="tv-cap-list">
                                <% for (let c = 0; c < capOrder.length; c++) { %>
                                    <% const key = capOrder[c]; %>
                                    <% const enabled = !!normalizedCaps[key]; %>
                                    <span class="tv-cap <%- enabled ? 'tv-cap-ok' : 'tv-cap-off' %>"><%- key %>: <%- enabled ? 'true' : 'false' %></span>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                <% } %>
            </div>
            <br><br>
        <hr style="border-color:rgb(236, 6, 6)"><br>
        <br>
        </form>

<form action='../system', method='POST', content-type="text/javascript">
    <br><br>
        <hr style="border-color:rgb(236, 6, 6)"><br>
