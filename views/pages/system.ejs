<form action='../system', method='POST', content-type="text/javascript">
    <br>
        <div style="text-align: center;">
            <button type="submit" 
                    name="setting" 
                    value="setting" 
                    class="btn btn-danger mb-3">
                IP, Gateway, Hostname
            </button>
